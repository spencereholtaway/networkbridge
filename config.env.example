# Copy to config.env (git-ignored) and fill in. Plain POSIX shell syntax:
# keep the double quotes, no spaces around '='.

# --- Router (while it is still on the bench, wired, fresh DD-WRT) ---
ROUTER_IP="192.168.1.1"          # DD-WRT default. After Part C it becomes $LAN_IP.

# --- Radio to use for the bridge link to the Eero ---
# R8000 radios: wl0 = 2.4 GHz, wl1 = 5 GHz (low band), wl2 = 5 GHz (high band).
# Start with wl1. If the bridge will not connect, try wl2, then wl0 (2.4 GHz).
RADIO="wl1"

# --- The Eero network you are bridging onto (exact spelling, case-sensitive) ---
EERO_SSID="My Eero Network"
EERO_PSK="eero-wifi-password"
# Security mode of the Eero network. psk2 = WPA2 Personal (default, safest bet).
# Use "psk2 psk3" only if the bridge refuses to associate and you have confirmed
# the Eero is in WPA3 transition mode. (Eero defaults to WPA2.)
EERO_SEC="psk2"

# --- The new SSID your office devices will join (broadcast by the R8000) ---
EXT_SSID="Office-Ext"
EXT_PSK="choose-a-new-password"

# --- Addressing on the Eero LAN ---
LAN_IP="192.168.4.2"             # must be free and outside the Eero DHCP range
LAN_MASK="255.255.255.0"
GATEWAY="192.168.4.1"            # the Eero gateway IP (check in the Eero app)
DNS="192.168.4.1"
